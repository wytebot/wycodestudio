# Firebase Web App configuration is intentionally hardcoded in src/main.jsx for this single-owner Studio.
# No VITE_* Firebase variables are required.

# Required for api/upload.js (uploading product source files and cover images to Google Drive):
# Service account JSON with write access to the shared Drive folder. Share the folder
# with this service account's client_email as an Editor.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Destination folder for product source ZIP files. Required in Vercel.
GOOGLE_DRIVE_FOLDER_ID=


