# Firebase Web App configuration is intentionally hardcoded in src/main.jsx for this single-owner Studio.
# No VITE_* Firebase variables are required.

# Google Drive OAuth 2.0 (server-side only). These credentials must NEVER be VITE_* variables.
# The refresh token must belong to the permitted Studio owner account.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# Destination folder for product source ZIP files. Required in Vercel.
GOOGLE_DRIVE_FOLDER_ID=

