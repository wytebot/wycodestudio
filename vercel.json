{
  "buildCommand": "npm run build",
  "installCommand": "npm install --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/email-worker",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
