rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "frenemy566@gmail.com";
    }
    match /products/{id} { allow read, write: if isAdmin(); }
    match /orders/{id} { allow read: if isAdmin(); allow write: if false; }
    match /customers/{id} { allow read: if isAdmin(); allow write: if false; }
  }
}
